library(gsheet)
library(tidyverse)
mg <- gsheet2tbl("https://docs.google.com/spreadsheets/d/1bq2N19DcZdtax2fQW9OHSGMR0X2__Z9T/edit#gid=983033137")
mg |>
ggplot (aes( trat, comp)) +
geom_boxplot()
library(report) #"report" -> convierte los modelos estadísticos y las tablas de datos en informes textuales aptos para su publicación, garantizando la normalización y la calidad en la presentación de los resultados.
mg2 <- mg |>
pivot_wider(names_from = trat,
values_from= comp) #pivot_wider() permite pivotar los datos de mg de formato largo a ancho. Esto significa que los valores únicos de trat se convertirán en columnas y comp será el valor de esas columnas.
t.test (mg2$Mg2, mg2$control) #comparo las medias de dos muestras independientes, en este caso, control y Mg2 dentro del data frame mg2.
# Se p valor for menor que 5% ( p < 0.05), la tendencia científica consiste en rechazar la hipótesis de que las diferencias se deben al azar (rechazamos la hipótesis nula) y afirmamos haber encontrado una diferencia estadísticamente significativa.
shapiro.test(mg2$control) # Realiza una prueba de normalidad utilizando el test de Shapiro-Wilk para la muestra control dentro del data frame mg2
shapiro.test(mg2$Mg2) #Realiza una prueba de normalidad utilizando el test de Shapiro-Wilk para la muestra Mg2 dentro del data frame mg2
hist(mg2$control)
hist(mg2$Mg2) #Crea histogramas para visualizar la distribución de los datos en las muestras control y Mg2.
qqnorm (mg2$control) #Crea un gráfico de cuantiles normales (QQ plot) para evaluar la normalidad de la muestra control
qqline (mg2$control) #Agrega una línea de referencia al gráfico de cuantiles normales que pasa por los cuartiles de la muestra control, lo que ayuda a visualizar la desviación de la normalidad.
var.test(mg2$control, mg2$Mg2)
var.test (mg2$control,mg2$Mg2)
teste1 <- t.test(mg2$control, mg2$Mg2)
report (teste1)
escala <- gsheet2tbl("https://docs.google.com/spreadsheets/d/1bq2N19DcZdtax2fQW9OHSGMR0X2__Z9T/edit#gid=1729131173")
escala
escala |>
ggplot(aes(assessment, acuracia)) +
geom_boxplot ()
library (dplyr)
escala2 <- escala |>
select(assessment, rater, acuracia) |>
pivot_wider(names_from = assessment,
values_from = acuracia)
t.test (escala2$Unaided, escala2$Aided1)
shapiro.test(escala2$Unaided)
shapiro.test (escala2$Aided1)
var.test(escala2$Unaided,escala2$Aided1)
t.test(escala2$Aided1, escala2$Unaided,
paired = TRUE,
var.equal = FALSE)
wilcox.test(escala2$Aided1,
escala2$Unaided,
paired = TRUE)
wilcox.test(mg2$control, mg2$Mg2,
paired = FALSE)
